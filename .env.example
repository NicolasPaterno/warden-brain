# Copy to .env and adjust if needed. NEVER commit .env.
# Ollama runs locally — no API key. The server must be running (`ollama serve`)
# and the model pulled (`ollama pull <model>`) before the brain can answer.

# --- LLM (local Ollama) ---
LLM_HOST=http://localhost:11434
LLM_MODEL=llama3.2:3b

# --- Service ---
APP_ENV=local
LOG_LEVEL=info
# Outbound HTTP timeout (seconds) for auth + gateway calls.
HTTP_TIMEOUT_SECONDS=10.0
# Browser origins allowed to call /chat cross-origin (JSON list). Empty disables CORS.
# e.g. CORS_ALLOW_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_ORIGINS=[]

# --- Downstream services ---
AUTH_BASE_URL=http://localhost:8082
GATEWAY_BASE_URL=http://localhost:8080
BRAIN_CLIENT_ID=brain
BRAIN_CLIENT_SECRET=dev-brain-secret

# --- User-token verification (Phase 4, JWKS from auth) ---
JWT_ISSUER=warden-auth
JWT_AUDIENCE=warden-brain
JWT_JWKS_PATH=/.well-known/jwks.json

# --- Observability (Phase 5) ---
# Leave OTEL endpoint empty to disable tracing locally (no Jaeger needed).
# In docker-compose this points at the Jaeger collector's OTLP gRPC port.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=warden-brain
