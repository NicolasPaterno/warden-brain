# Copy to .env and adjust if needed. NEVER commit .env.
# Ollama runs locally — no API key. The server must be running (`ollama serve`)
# and the model pulled (`ollama pull <model>`) before the brain can answer.

# --- Ollama (local LLM) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Service ---
APP_ENV=local
LOG_LEVEL=info

AUTH_BASE_URL=http://localhost:8082
GATEWAY_BASE_URL=http://localhost:8080
BRAIN_CLIENT_ID=brain
BRAIN_CLIENT_SECRET=dev-brain-secret